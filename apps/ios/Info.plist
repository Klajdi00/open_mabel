<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ANTHROPIC_DEFAULT_KEY</key>
	<string>$(ANTHROPIC_DEFAULT_KEY)</string>
	<key>CFBundleDisplayName</key>
	<string>MABEL V2</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.example.MABEL-Mobile-App-V2</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mabelv2</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_mabel-teleop._tcp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>MABEL uses Bluetooth to find your robot when you are near it and to drive it directly — so teleoperation keeps working with no Wi-Fi and no internet.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MABEL connects to your robot or MuJoCo simulation server on the local network to stream camera video and send teleoperation commands.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MABEL uses the microphone so you can talk to the robot — dictate commands and chat with it hands-free.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MABEL transcribes your speech on-device so you can command and chat with the robot by voice.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
