  "env": {
    "subsystem_prefix": "MABEL_HW_",
    "http_port": "MABEL_HTTP_PORT",
    "hand_bridge_port": "MABEL_HAND_BRIDGE_PORT",
    "lock_override": "MABEL_HW_LOCK"
  },
  "lock_path": "/tmp/mabel_hardware_bridge.lock",
  "source_needles": [
    {
      "file": "mabel_hw/singleton.py",
      "contains": "/tmp/mabel_hardware_bridge.lock",
      "why": "flock singleton path; server/real_run.sh + tools/singleton_test.sh rely on it"
    },
    {
      "file": "mabel_hw/singleton.py",
      "contains": "MABEL_HW_LOCK",
      "why": "selftest isolates itself via this env override"
    },
    {
      "file": "hardware_bridge.py",
      "contains": "_acquire_singleton",
      "why": "launcher must keep re-exporting the singleton surface"
    },
    {
      "file": "mabel_hw/cameras/manager.py",
      "contains": "mabel_hw.cameras.camera_worker",
      "why": "per-camera worker subprocess spawn string (python3 -m ...)"
    },
    {
      "file": "mabel_hw/cameras/manager.py",
      "contains": "mabel_hw.cameras.video_relay",
      "why": "video relay subprocess spawn string"
    },
    {
      "file": "mabel_hw/cameras/camera_worker.py",
      "contains": "main()",
      "why": "the -m mabel_hw.cameras.camera_worker entry must stay runnable"
    },
    {
      "file": "mabel_hw/cameras/video_relay.py",
      "contains": "main()",
      "why": "the -m mabel_hw.cameras.video_relay entry must stay runnable"
    },
    {
      "file": "mabel_hw/rpc/hand_server.py",
      "contains": "\"mabel_hw.rpc.hand_server\"",
      "why": "ensure_daemon self-spawn string (python3 -m mabel_hw.rpc.hand_server)"
    },
    {
      "file": "mabel_hw/ros/hands_node.py",
      "contains": "_hand\"",
      "why": "per-side hand namespace /<side>_hand/* is built here"
    },
    {
      "file": "run_bridge.sh",
      "contains": "hardware_bridge.py",
      "why": "systemd entry: run_bridge.sh execs this exact filename with cwd=bridge dir"
    },
    {
      "file": "mabel_hw/drivers/audio.py",
      "contains": "card_for_usb_id",
      "why": "port-independent card resolution (VID:PID -> ALSA card id); real_run.sh and exp_audio.py rely on the bar being found on ANY USB port"
    },
    {
      "file": "mabel_hw/config.py",
      "contains": "plughw:CARD=Device,DEV=0",
      "why": "the wire is 16 kHz MONO and the card is 2ch \u2014 the plug layer's channel (and, on the old 48kHz-only bar, rate) conversion is load-bearing; a bare hw: device string must never come back"
    }
  ]
}