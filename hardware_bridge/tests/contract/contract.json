    "lift_calibrate": "/lift/calibrate",
    "lift_limits": "/lift/limits",
    "lidar_scan": "/scan",
    "audio_speaker": "/audio/speaker",
    "audio_mic": "/audio/mic",
    "audio_enable": "/audio/enable",
    "audio_state": "/audio/state",
