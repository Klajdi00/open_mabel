<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mabel_base_hardware</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="maintainers@example.com">mabel</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>mabel_interfaces</exec_depend>
  <!-- base_bridge_client publishes Twist/Bool/Float64 to the hardware_bridge. -->
  <exec_depend>std_msgs</exec_depend>
  <!-- swerve_odometry (the wheel-odometry motion model) now lives HERE (the base
       HAL), shared by the real base + the sim; needs these for /odom + the TF. -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
