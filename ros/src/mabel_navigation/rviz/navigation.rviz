Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map (SLAM)1
        - /Global Costmap1
        - /Global Plan1
        - /Frontiers1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Cell Size: 1.0
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.4
      Show Names: true
    # ---- the SLAM occupancy grid (same /map for LiDAR or visual backend) ----
    - Class: rviz_default_plugins/Map
      Name: Map (SLAM)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.9
    # ---- Nav2 global costmap (planning) ----
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
    # ---- Nav2 local costmap (reactive avoidance) ----
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.4
    # ---- current LiDAR scan ----
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.04
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
    # ---- Nav2 global plan ----
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
    # ---- controller local plan ----
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color: 0; 170; 255
      Line Style: Lines
    # ---- exploration frontiers (orange = candidate, green = current goal) ----
    - Class: rviz_default_plugins/MarkerArray
      Name: Frontiers
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /frontier_explorer/frontiers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    # ---- the goal you set (and the one the explorer is chasing) ----
    - Class: rviz_default_plugins/Pose
      Name: Goal Pose
      Enabled: true
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 25; 0
      Shape: Arrow
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    # The "2D Goal Pose" tool -> /goal_pose -> goal_relay -> Nav2 NavigateToPose.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 14.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.0
      Pitch: 1.2
      Yaw: 0.785
Window Geometry:
  Height: 950
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: false
