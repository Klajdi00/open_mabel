<mujoco model="mabel_right_arm">

  <compiler angle="radian" eulerseq="XYZ"/>
  <option gravity="0 0 0" timestep="0.002"/>

  <default>
    <mesh scale="0.001 0.001 0.001"/>
    
    <default class="ra_visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="ra_collision">
      <geom type="mesh" contype="1" conaffinity="0" group="1" rgba="1 1 1 0"/>
    </default>
    
    <default class="motor_DM8009">
      <joint frictionloss="0.5" damping="0.5" armature="0.10" limited="true" type="hinge" />
    </default>
    <default class="motor_DM4340">
      <joint frictionloss="0.5" damping="0.5" armature="0.08" limited="true" type="hinge" />
    </default>
    <default class="motor_DM4310">
      <joint frictionloss="0.5" damping="0.5" armature="0.05" limited="true" type="hinge" />
    </default>
  </default>

  <asset>
    <mesh file="../assets/meshes/arms/right/1_body_to_arm.stl"       name="m_r_1_mount"/>
    <mesh file="../assets/meshes/arms/right/2_shoulder.stl"          name="m_r_2_shoulder"/>
    <mesh file="../assets/meshes/arms/right/3_shoulder_to_elbow.stl" name="m_r_3_s_link"/>
    <mesh file="../assets/meshes/arms/right/4_upper_arm.stl"         name="m_r_4_s_link"/>
    <mesh file="../assets/meshes/arms/right/5_elbow.stl"             name="m_r_5_elbow"/>
    <mesh file="../assets/meshes/arms/right/6_forearm.stl"           name="m_r_6_forearm"/>
    <mesh file="../assets/meshes/arms/right/7_wrist.stl"             name="m_r_7_wrist"/>
    <mesh file="../assets/meshes/arms/right/8_arm_to_hand.stl"       name="m_r_8_hand_mount"/>

    <material name="mat_ra_dark"  rgba="0.24 0.24 0.24 1"/>
    <material name="mat_ra_light" rgba="0.80 0.80 0.80 1"/>
    <material name="mat_ra_acc"   rgba="0.80 0.30 0.10 1"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.7 0.7 0.7 1"/>

    <body name="r_arm_mount" pos="0.0 -0.031 0.698" euler="1.570796 0 0">
      <geom class="ra_visual" mesh="m_r_1_mount" material="mat_ra_dark" pos="0 0 0" euler="0 0 0"/>
      <geom class="ra_collision" mesh="m_r_1_mount"/>

      <body name="r_shoulder_1" pos="0.0 0.0 0.0" euler="0 0 0">
        <joint name="r_j1" class="motor_DM8009" axis="0 0 1" range="-3.490659 1.396263"/> 
        <geom class="ra_visual" mesh="m_r_2_shoulder" material="mat_ra_light" pos="0 0 0" euler="0 0 0"/>
        
        <body name="r_shoulder_2" pos="-0.0301 0.0 0.06" euler="0 -1.570796 0">
          <joint name="r_j2" class="motor_DM8009" axis="0 0 1" range="-0.174533 3.316125"/>
          <geom class="ra_visual" mesh="m_r_3_s_link" material="mat_ra_dark" pos="0 0 0" euler="0 0 0"/>
          
          <body name="r_shoulder_3" pos="0.0 -0.06625 -0.0301" euler="-1.570796 0 3.1415926">
            <joint name="r_j3" class="motor_DM4340" axis="0 0 1" range="-1.570796 1.570796"/>
            <geom class="ra_visual" mesh="m_r_4_s_link" material="mat_ra_light" pos="0 0 0" euler="0 0 0"/>
            
            <body name="r_elbow" pos="0.0315 0.0 0.15375" euler="0 -1.570796 0">
              <joint name="r_j4" class="motor_DM4340" axis="0 0 1" range="-0.773461 1.67"/>
              <geom class="ra_visual" mesh="m_r_5_elbow" material="mat_ra_dark" pos="0 0 0" euler="0 0 0"/>
              
              <body name="r_forearm" pos="0.0 -0.0955 0.0315" euler="1.570796 0 0"> 
                <joint name="r_j5" class="motor_DM4310" axis="0 0 1" range="-1.570796 1.570796"/>
                <geom class="ra_visual" mesh="m_r_6_forearm" material="mat_ra_light" pos="0 0 0" euler="0 0 0"/>
                
                <body name="r_wrist" pos="-0.0375 0.0 0.1205" euler="1.570796 3.14 1.570796">
                  <joint name="r_j6_wrist" class="motor_DM4310" axis="0 0 1" range="-0.785398 0.785398"/>
                  <geom class="ra_visual" mesh="m_r_7_wrist" material="mat_ra_dark" pos="0 0 0" euler="0 0 0"/>
                  
                  <body name="r_hand_mount" pos="0.02 0.0 0.035" euler="1.570796 1.570796 1.570796">
                    <joint name="r_j7_roll" class="motor_DM4310" axis="0 0 1" range="-1.570796 1.570796"/>
                    <geom class="ra_visual" mesh="m_r_8_hand_mount" material="mat_ra_acc" pos="0 0 0" euler="0 0 0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="r_arm_mount"  body2="r_shoulder_1"/>
    <exclude body1="r_shoulder_1" body2="r_shoulder_2"/>
    <exclude body1="r_shoulder_2" body2="r_shoulder_3"/>
    <exclude body1="r_shoulder_3" body2="r_elbow"/>
    <exclude body1="r_elbow"      body2="r_forearm"/>
    <exclude body1="r_forearm"    body2="r_wrist"/>
    <exclude body1="r_wrist"      body2="r_hand_mount"/>
  </contact>

  <actuator>
    <position name="r_act_j1" joint="r_j1" kp="500" kv="45" ctrlrange="-3.491 1.396" ctrllimited="true" forcerange="-40 40"/>
    <position name="r_act_j2" joint="r_j2" kp="500" kv="45" ctrlrange="-0.175 3.316" ctrllimited="true" forcerange="-40 40"/>
    <position name="r_act_j3" joint="r_j3" kp="500" kv="45" ctrlrange="-1.571 1.571" ctrllimited="true" forcerange="-27 27"/>
    <position name="r_act_j4" joint="r_j4" kp="500" kv="45" ctrlrange="-0.773 1.670"  ctrllimited="true" forcerange="-27 27"/>
    <position name="r_act_j5" joint="r_j5" kp="500" kv="45" ctrlrange="-1.571 1.571" ctrllimited="true" forcerange="-7 7"/>
    <position name="r_act_j6" joint="r_j6_wrist" kp="500" kv="45" ctrlrange="-0.785 0.785" ctrllimited="true" forcerange="-7 7"/>
    <position name="r_act_j7" joint="r_j7_roll"  kp="500" kv="45" ctrlrange="-1.571 1.571" ctrllimited="true" forcerange="-7 7"/>
  </actuator>

</mujoco>