<mujoco model="mabel_assembly_line_environment">
  <!-- MABEL at an assembly line: a 9 m belt conveyor with parts on it, workstations
       on both sides (operator slot at the origin), parts bins, stools, hazard lane
       markings. Textured primitives (textures from scripts/tools/gen_env_textures.py);
       the parts on the belt are scanned objects wired by gen_env_objects.py.
       Run from repo root:  python scripts/visualize_sensors.py --scene scenes/mabel_assembly_line.xml -->

  <compiler angle="radian" eulerseq="XYZ"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"
          cone="elliptic" noslip_iterations="3"/>

  <include file="../models/mabel_full.xml"/>

  <visual>
    <headlight ambient="0.44 0.44 0.46" diffuse="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.52 0.58 0.66" rgb2="0.86 0.89 0.93" width="256" height="256"/>
    <texture type="2d" name="t_concrete" file="../assets/textures/concrete.png"/>
    <texture type="2d" name="t_wall"     file="../assets/textures/wall.png"/>
    <texture type="2d" name="t_metal"    file="../assets/textures/metal_brushed.png"/>
    <texture type="2d" name="t_belt"     file="../assets/textures/conveyor.png"/>
    <texture type="2d" name="t_hazard"   file="../assets/textures/hazard.png"/>
    <texture type="2d" name="t_wood"     file="../assets/textures/wood_furniture.png"/>
    <texture type="2d" name="t_screen"   file="../assets/textures/monitor.png"/>

    <material name="m_concrete" texture="t_concrete" texuniform="true" texrepeat="0.6 0.6" reflectance="0.08" shininess="0.2"/>
    <material name="m_wall"     texture="t_wall"     texuniform="true" texrepeat="2 2" reflectance="0.0"/>
    <material name="m_metal"    texture="t_metal"    texuniform="true" texrepeat="2 2" reflectance="0.35" shininess="0.7" specular="0.5"/>
    <material name="m_belt"     texture="t_belt"     texrepeat="14 1" reflectance="0.05" shininess="0.2"/>
    <material name="m_hazard"   texture="t_hazard"   texuniform="true" texrepeat="2 2" reflectance="0.0" shininess="0.1"/>
    <material name="m_wood"     texture="t_wood"     texuniform="true" texrepeat="2 2" reflectance="0.05" shininess="0.2"/>
    <material name="m_screen"   texture="t_screen"   texrepeat="1 1" reflectance="0.3" shininess="0.8" emission="0.55"/>
    <material name="m_frame"    rgba="0.30 0.42 0.55 1" reflectance="0.25" shininess="0.5"/>
    <material name="m_dark"     rgba="0.16 0.17 0.19 1" reflectance="0.2" shininess="0.4"/>
    <material name="m_bin_red"  rgba="0.75 0.22 0.18 1" shininess="0.4"/>
    <material name="m_bin_blue" rgba="0.20 0.35 0.68 1" shininess="0.4"/>
    <material name="m_bin_yel"  rgba="0.88 0.72 0.12 1" shininess="0.4"/>
  </asset>

  <worldbody>
    <!-- ===== lighting ===== -->
    <light name="bay1" directional="true" pos=" 2.0  1.0 4.0" dir="-0.25 -0.2 -1" diffuse="0.52 0.52 0.50" specular="0.25 0.25 0.25" castshadow="true"/>
    <light name="bay2" directional="true" pos="-3.0  0.0 4.0" dir=" 0.35  0.0 -1" diffuse="0.30 0.30 0.32" castshadow="false"/>
    <light name="bay3" directional="true" pos=" 0.0 -2.5 4.0" dir=" 0.0   0.5 -1" diffuse="0.24 0.24 0.26" castshadow="false"/>

    <!-- ===== hall shell 12 x 8 m ===== -->
    <geom name="floor" type="plane" size="6 4 0.1" material="m_concrete"
          contype="1" conaffinity="1" friction="1.5 0.05 0.001"/>
    <geom name="wall_back"  type="box" pos=" 6.05 0    1.6" size="0.05 4.0 1.6" material="m_wall"/>
    <geom name="wall_front" type="box" pos="-6.05 0    1.6" size="0.05 4.0 1.6" material="m_wall"/>
    <geom name="wall_left"  type="box" pos=" 0    4.05 1.6" size="6.0 0.05 1.6" material="m_wall"/>
    <geom name="wall_right" type="box" pos=" 0   -4.05 1.6" size="6.0 0.05 1.6" material="m_wall"/>
    <geom name="wall_stripe_l" type="box" pos="0  3.99 0.18" size="6.0 0.012 0.18" material="m_hazard"/>
    <geom name="wall_stripe_r" type="box" pos="0 -3.99 0.18" size="6.0 0.012 0.18" material="m_hazard"/>

    <!-- ===== belt conveyor along X at y = +1.8 (belt top 0.85 m) ===== -->
    <geom name="conv_rail_n" type="box" pos="0 2.22 0.76" size="4.60 0.04 0.06" material="m_frame"/>
    <geom name="conv_rail_s" type="box" pos="0 1.38 0.76" size="4.60 0.04 0.06" material="m_frame"/>
    <!-- the belt rides a slide joint: simulation_bridge/dynamics.py drives it at
         belt speed and wraps it back by one texture period (9.8 m / texrepeat 14
         = 0.70 m) so the wrap is invisible and parts are CARRIED by real friction
         (spec in mabel_assembly_line.dynamics.json; static without the bridge) -->
    <body name="conv_belt_carrier" pos="0 1.80 0.81">
      <joint name="conv_belt_slide" type="slide" axis="1 0 0" damping="400" range="-0.5 0.5"/>
      <geom name="conv_belt" type="box" size="4.9 0.38 0.04" material="m_belt" mass="60"
            contype="2" conaffinity="2" friction="1.2 0.05 0.001"/>
    </body>
    <geom name="conv_roller_e" type="cylinder" pos=" 4.62 1.80 0.78" size="0.07 0.40" euler="1.570795 0 0" material="m_metal"/>
    <geom name="conv_roller_w" type="cylinder" pos="-4.62 1.80 0.78" size="0.07 0.40" euler="1.570795 0 0" material="m_metal"/>
    <geom name="conv_leg1" type="box" pos="-3.6 1.80 0.36" size="0.05 0.34 0.36" material="m_dark"/>
    <geom name="conv_leg2" type="box" pos="-1.8 1.80 0.36" size="0.05 0.34 0.36" material="m_dark"/>
    <geom name="conv_leg3" type="box" pos=" 0.0 1.80 0.36" size="0.05 0.34 0.36" material="m_dark"/>
    <geom name="conv_leg4" type="box" pos=" 1.8 1.80 0.36" size="0.05 0.34 0.36" material="m_dark"/>
    <geom name="conv_leg5" type="box" pos=" 3.6 1.80 0.36" size="0.05 0.34 0.36" material="m_dark"/>

    <!-- hazard lane in front of the conveyor (leaves the 1.2 m spawn circle clear) -->
    <geom name="lane_stripe" type="box" pos="0 1.28 0.002" size="4.60 0.06 0.002" material="m_hazard"/>

    <!-- ===== far-side workstations (y = +3.1), facing the belt ===== -->
    <geom name="wsA_top" type="box" pos="-3.0 3.10 0.85" size="0.62 0.38 0.025" material="m_wood"/>
    <geom name="wsA_l1"  type="box" pos="-3.55 2.80 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsA_l2"  type="box" pos="-2.45 2.80 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsA_l3"  type="box" pos="-3.55 3.40 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsA_l4"  type="box" pos="-2.45 3.40 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsA_bin1" type="box" pos="-3.30 3.22 0.945" size="0.14 0.11 0.07" material="m_bin_red"/>
    <geom name="wsA_bin2" type="box" pos="-2.95 3.25 0.945" size="0.14 0.11 0.07" material="m_bin_blue"/>
    <geom name="wsA_bin3" type="box" pos="-2.62 3.20 0.945" size="0.12 0.10 0.07" material="m_bin_yel"/>

    <geom name="wsB_top" type="box" pos="0.0 3.10 0.85" size="0.62 0.38 0.025" material="m_wood"/>
    <geom name="wsB_l1"  type="box" pos="-0.55 2.80 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsB_l2"  type="box" pos=" 0.55 2.80 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsB_l3"  type="box" pos="-0.55 3.40 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsB_l4"  type="box" pos=" 0.55 3.40 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsB_mon_post"  type="box" pos="0.0 3.38 1.02" size="0.02 0.02 0.14" material="m_dark"/>
    <geom name="wsB_mon_frame" type="box" pos="0.0 3.36 1.28" size="0.26 0.02 0.17" material="m_dark"/>
    <geom name="wsB_mon_screen" type="box" pos="0.0 3.335 1.28" size="0.23 0.004 0.14" material="m_screen"/>
    <geom name="wsB_bin1" type="box" pos="-0.35 3.18 0.945" size="0.14 0.11 0.07" material="m_bin_blue"/>
    <geom name="wsB_bin2" type="box" pos=" 0.38 3.20 0.945" size="0.14 0.11 0.07" material="m_bin_yel"/>

    <geom name="wsC_top" type="box" pos="3.0 3.10 0.85" size="0.62 0.38 0.025" material="m_wood"/>
    <geom name="wsC_l1"  type="box" pos="2.45 2.80 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsC_l2"  type="box" pos="3.55 2.80 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsC_l3"  type="box" pos="2.45 3.40 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsC_l4"  type="box" pos="3.55 3.40 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsC_bin1" type="box" pos="2.70 3.22 0.945" size="0.14 0.11 0.07" material="m_bin_red"/>
    <geom name="wsC_bin2" type="box" pos="3.30 3.24 0.945" size="0.14 0.11 0.07" material="m_bin_blue"/>

    <!-- ===== near-side benches, leaving the operator slot at the origin ===== -->
    <geom name="wsD_top" type="box" pos="-3.0 0.55 0.85" size="0.62 0.38 0.025" material="m_wood"/>
    <geom name="wsD_l1"  type="box" pos="-3.55 0.25 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsD_l2"  type="box" pos="-2.45 0.25 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsD_l3"  type="box" pos="-3.55 0.85 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsD_l4"  type="box" pos="-2.45 0.85 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsD_bin1" type="box" pos="-3.15 0.62 0.945" size="0.14 0.11 0.07" material="m_bin_yel"/>

    <geom name="wsE_top" type="box" pos="3.0 0.55 0.85" size="0.62 0.38 0.025" material="m_wood"/>
    <geom name="wsE_l1"  type="box" pos="2.45 0.25 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsE_l2"  type="box" pos="3.55 0.25 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsE_l3"  type="box" pos="2.45 0.85 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsE_l4"  type="box" pos="3.55 0.85 0.41" size="0.04 0.04 0.41" material="m_dark"/>
    <geom name="wsE_bin1" type="box" pos="3.25 0.60 0.945" size="0.14 0.11 0.07" material="m_bin_red"/>

    <!-- stools at the workstations -->
    <geom name="stool1_post" type="cylinder" pos="-3.0 2.45 0.30" size="0.03 0.30" material="m_dark"/>
    <geom name="stool1_seat" type="cylinder" pos="-3.0 2.45 0.63" size="0.17 0.03" material="m_frame"/>
    <geom name="stool2_post" type="cylinder" pos=" 3.0 2.45 0.30" size="0.03 0.30" material="m_dark"/>
    <geom name="stool2_seat" type="cylinder" pos=" 3.0 2.45 0.63" size="0.17 0.03" material="m_frame"/>

    <!-- ===== end-of-line pallet with finished boxes (+X end) ===== -->
    <geom name="eol_deck" type="box" pos="5.35 1.80 0.12" size="0.50 0.42 0.03" material="m_wood"/>
    <geom name="eol_box1" type="box" pos="5.30 1.65 0.40" size="0.26 0.24 0.25" rgba="0.72 0.58 0.42 1"/>
    <geom name="eol_box2" type="box" pos="5.42 2.00 0.86" size="0.22 0.20 0.21" rgba="0.68 0.54 0.40 1" euler="0 0 0.2"/>

    <!-- ===== teleop mocap targets (kept compatible with the teleop / WBC scripts) ===== -->
    <body name="target_l" mocap="true" pos="0.45 0.3 1.0">
      <geom group="3" type="sphere" size="0.03" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
    <body name="target_r" mocap="true" pos="0.45 -0.3 1.0">
      <geom group="3" type="sphere" size="0.03" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
    <body name="gaze_point" mocap="true" pos="0.85 0 1.0">
      <geom group="3" type="sphere" size="0.04" rgba="1 0.5 0 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- parts on the belt (scanned objects) -->
  <include file="assembly_objects.xml"/>

  <!-- line worker (generated by scripts/tools/scenegen; animated by the bridge) -->
  <include file="assembly_actors.xml"/>

</mujoco>
