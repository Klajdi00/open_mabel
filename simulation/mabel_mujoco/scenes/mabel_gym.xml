    <texture type="2d" name="t_rug" file="../assets/textures/rug.png"/>
    <material name="m_rug" texture="t_rug" texrepeat="1 1" reflectance="0.0"/>
    <texture type="2d" name="t_screen" file="../assets/textures/monitor.png"/>
