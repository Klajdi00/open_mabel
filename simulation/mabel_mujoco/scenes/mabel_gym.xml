    <material name="m_metal" texture="t_metal" texuniform="true" texrepeat="2 2" reflectance="0.35" shininess="0.7" specular="0.5"/>
    <material name="m_mirror" rgba="0.80 0.84 0.88 1" reflectance="0.85" shininess="1.0" specular="1.0"/>
    <texture type="2d" name="t_rubber" file="../assets/textures/rubber_floor.png"/>
