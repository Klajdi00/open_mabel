<mujoco model="mabel_home_environment">
  <!-- MABEL in a kitchen / dining home environment.
       - room shell (wood floor + plaster walls) and furniture are textured primitives
         (textures generated by scripts/tools/gen_home_textures.py)
       - graspable clutter on the island/counter are REAL Google-Scanned-Objects meshes
         (CC-BY 4.0), wired in by scripts/tools/gen_home_objects.py -> home_objects.xml
       Run from repo root:  python scripts/visualize_sensors.py --scene scenes/mabel_home.xml -->

  <compiler angle="radian" eulerseq="XYZ"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"
          cone="elliptic" noslip_iterations="3"/>

  <include file="../models/mabel_full.xml"/>

  <visual>
    <headlight ambient="0.45 0.45 0.47" diffuse="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.52 0.58 0.66" rgb2="0.86 0.89 0.93" width="256" height="256"/>
    <texture type="2d"      name="t_floor"  file="../assets/textures/wood_floor.png"/>
    <texture type="2d"      name="t_wood"   file="../assets/textures/wood_furniture.png"/>
    <texture type="2d"      name="t_marble" file="../assets/textures/marble_counter.png"/>
    <texture type="2d"      name="t_wall"   file="../assets/textures/wall.png"/>
    <texture type="2d"      name="t_tile"   file="../assets/textures/tile.png"/>

    <material name="m_floor"  texture="t_floor"  texuniform="true" texrepeat="2 2"  reflectance="0.10" shininess="0.1"/>
    <material name="m_wood"   texture="t_wood"   texuniform="true" texrepeat="2 2"  reflectance="0.05" shininess="0.2"/>
    <material name="m_marble" texture="t_marble" texuniform="true" texrepeat="1 1"  reflectance="0.25" shininess="0.6" specular="0.5"/>
    <material name="m_wall"   texture="t_wall"   texuniform="true" texrepeat="2 2"  reflectance="0.0"/>
    <material name="m_tile"   texture="t_tile"   texuniform="true" texrepeat="3 1"  reflectance="0.15" shininess="0.4"/>
    <material name="m_steel"  rgba="0.82 0.84 0.87 1" reflectance="0.35" shininess="0.7" specular="0.6"/>
    <material name="m_rug"    rgba="0.42 0.30 0.27 1" reflectance="0.0" shininess="0.0"/>
  </asset>

  <worldbody>
    <!-- ===== lighting (indoor): directional lights illuminate evenly (no spotlight pools) ===== -->
    <light name="sun"    directional="true" pos=" 1.0  0.6 3.0" dir="-0.35 -0.2 -1" diffuse="0.55 0.54 0.52" specular="0.25 0.25 0.25" castshadow="true"/>
    <light name="fill_x" directional="true" pos="-2.0  0.0 3.0" dir=" 0.40  0.0 -1" diffuse="0.30 0.30 0.33" castshadow="false"/>
    <light name="window" directional="true" pos=" 1.0  2.4 2.0" dir=" 0.0 -0.6 -1" diffuse="0.28 0.30 0.36" castshadow="false"/>

    <!-- ===== room shell ===== -->
    <geom name="floor" type="plane" size="3 2.5 0.1" material="m_floor"
          contype="1" conaffinity="1" friction="1.5 0.05 0.001"/>
    <geom name="wall_back"  type="box" pos=" 3.05 0    1.3" size="0.05 2.5 1.3" material="m_wall"/>
    <geom name="wall_front" type="box" pos="-3.05 0    1.3" size="0.05 2.5 1.3" material="m_wall"/>
    <geom name="wall_left"  type="box" pos=" 0    2.55 1.3" size="3.0 0.05 1.3" material="m_wall"/>
    <geom name="wall_right" type="box" pos=" 0   -2.55 1.3" size="3.0 0.05 1.3" material="m_wall"/>

    <!-- ===== kitchen counter run along the back (+X) wall ===== -->
    <geom name="counter_base"  type="box" pos="2.70 -0.9 0.43" size="0.30 1.50 0.43" material="m_wood"/>
    <geom name="counter_top"   type="box" pos="2.66 -0.9 0.88" size="0.34 1.55 0.02" material="m_marble"/>
    <geom name="backsplash"    type="box" pos="2.985 -0.9 1.20" size="0.012 1.55 0.30" material="m_tile"/>
    <geom name="upper_cabinet" type="box" pos="2.82 -0.9 1.80" size="0.18 1.50 0.30" material="m_wood"/>
    <geom name="sink_basin"    type="box" pos="2.60 -1.5 0.85" size="0.18 0.22 0.05" material="m_steel"/>
    <geom name="faucet_post"   type="cylinder" pos="2.78 -1.5 0.97" size="0.012 0.08" material="m_steel"/>
    <geom name="faucet_spout"  type="box" pos="2.70 -1.5 1.05" size="0.09 0.012 0.012" material="m_steel"/>

    <!-- ===== fridge (steel) beside the counter ===== -->
    <geom name="fridge"        type="box" pos="2.62 1.65 0.90" size="0.34 0.38 0.90" material="m_steel"/>
    <geom name="fridge_handle" type="box" pos="2.27 1.40 1.10" size="0.02 0.02 0.35" material="m_wood"/>

    <!-- ===== work island in front of the robot (reachable work surface) ===== -->
    <geom name="island_base" type="box" pos="0.80 0 0.36"   size="0.36 0.72 0.36"  material="m_wood"/>
    <geom name="island_top"  type="box" pos="0.80 0 0.735"  size="0.42 0.78 0.025" material="m_marble"/>

    <!-- ===== dining set behind the robot (-X) ===== -->
    <geom name="rug" type="box" pos="-1.7 0 0.004" size="1.05 0.85 0.004" material="m_rug"/>
    <geom name="dtable_top" type="box" pos="-1.7 0 0.735" size="0.70 0.45 0.025" material="m_wood"/>
    <geom name="dtable_leg1" type="box" pos="-1.04 -0.38 0.355" size="0.03 0.03 0.355" material="m_wood"/>
    <geom name="dtable_leg2" type="box" pos="-1.04  0.38 0.355" size="0.03 0.03 0.355" material="m_wood"/>
    <geom name="dtable_leg3" type="box" pos="-2.36 -0.38 0.355" size="0.03 0.03 0.355" material="m_wood"/>
    <geom name="dtable_leg4" type="box" pos="-2.36  0.38 0.355" size="0.03 0.03 0.355" material="m_wood"/>

    <!-- chair A (+Y side) -->
    <geom name="chairA_seat" type="box" pos="-1.7  0.78 0.45" size="0.20 0.20 0.025" material="m_wood"/>
    <geom name="chairA_back" type="box" pos="-1.7  0.97 0.66" size="0.20 0.025 0.21" material="m_wood"/>
    <geom name="chairA_l1" type="box" pos="-1.52 0.60 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <geom name="chairA_l2" type="box" pos="-1.88 0.60 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <geom name="chairA_l3" type="box" pos="-1.52 0.96 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <geom name="chairA_l4" type="box" pos="-1.88 0.96 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <!-- chair B (-Y side) -->
    <geom name="chairB_seat" type="box" pos="-1.7 -0.78 0.45" size="0.20 0.20 0.025" material="m_wood"/>
    <geom name="chairB_back" type="box" pos="-1.7 -0.97 0.66" size="0.20 0.025 0.21" material="m_wood"/>
    <geom name="chairB_l1" type="box" pos="-1.52 -0.60 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <geom name="chairB_l2" type="box" pos="-1.88 -0.60 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <geom name="chairB_l3" type="box" pos="-1.52 -0.96 0.225" size="0.025 0.025 0.225" material="m_wood"/>
    <geom name="chairB_l4" type="box" pos="-1.88 -0.96 0.225" size="0.025 0.025 0.225" material="m_wood"/>

    <!-- ===== teleop mocap targets (kept compatible with the teleop / WBC scripts) ===== -->
    <body name="target_l" mocap="true" pos="0.45 0.3 1.0">
      <geom group="3" type="sphere" size="0.03" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
    <body name="target_r" mocap="true" pos="0.45 -0.3 1.0">
      <geom group="3" type="sphere" size="0.03" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
    <body name="gaze_point" mocap="true" pos="0.85 0 1.0">
      <geom group="3" type="sphere" size="0.04" rgba="1 0.5 0 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- real graspable kitchen objects on the island + counter -->
  <include file="home_objects.xml"/>

</mujoco>
