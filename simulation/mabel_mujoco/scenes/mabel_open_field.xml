<mujoco model="mabel_open_field">
  <!-- The --test sandbox for whole-body control / retargeting (server/run.sh --test):
       the full robot on a 120 x 120 m grid field with ONE manipulation table in front
       (the robot faces -X; table front edge x=-0.78) carrying graspable objects, and nothing else to collide with.
       Unlike mabel_bare.xml (the sys-id scene, kept as-is for controller/experiments),
       this one is built so the view NEVER dies at a boundary:
         - directional sun + sky fill light the WHOLE field uniformly (a positional
           spot only lit a ~4 m pool and everything beyond rendered black),
         - gradient skybox + ambient headlight so the head camera sees a horizon,
           not void, even at the floor's edge.
       mat_grid is texuniform, so the checker squares stay the same size as in
       mabel_bare.xml no matter the plane extent. Floor friction matches mabel_sim.xml.

       GRASP CONTACT RECIPE (why the objects pick up easily):
       Every object's collision geom carries priority="1" — MuJoCo then takes
       condim/friction/solref from the OBJECT alone, overriding the hand's plain
       condim-3 default-friction fingertip geoms (models/left_hand.xml) — so grasp
       physics is tuned HERE, in one place, per object:
         condim="6"                  torsional + rolling friction: a pinch resists
                                     twist-out and balls/cans don't roll away
         friction="2.0 0.02 0.002"   sliding mu 2.0 finger<->object: a two-finger
                                     pinch holds m*g with normal force N > m*g/(2*mu)
                                     = 0.6 N for the heaviest (0.25 kg) object
         solref="0.005 1"            slightly soft 5 ms contact, no bounce/chatter
         solimp="0.99 0.999 0.001"   stiff enough that fingers don't sink in
       Masses 0.10-0.25 kg. The option already runs elliptic cones +
       noslip_iterations=3 (same as every MABEL scene), which kills slow grip creep.
       The ball's rolling friction is raised further (0.005) so it stays put. -->

  <compiler angle="radian" eulerseq="XYZ"/>

  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"
          cone="elliptic" noslip_iterations="3"/>

  <include file="../models/mabel_full.xml"/>

  <!-- statistic pins the camera framing + shadowmap region to the ROBOT, not the
       120 m plane (else the free camera spawns 100 m out and the robot's shadow
       becomes a smear). Far from spawn the cast shadow may fade — cosmetic only. -->
  <statistic center="0 0 0.8" extent="8"/>

  <visual>
    <headlight ambient="0.45 0.47 0.50" diffuse="0.30 0.30 0.30" specular="0.1 0.1 0.1"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.45 0.68 0.93" rgb2="0.85 0.92 1.0" width="256" height="256"/>
    <!-- realistic graspable objects (same GSO assets as mabel_manip_table.xml) -->
    <texture type="2d" name="mug_red_tex" file="../assets/objects/ACE_Coffee_Mug_Kristen_16_oz_cup/texture.png"/>
    <material name="mug_red_mat" texture="mug_red_tex" specular="0.3" shininess="0.4"/>
    <!-- scale="1 1 1" is MANDATORY on every object mesh: mabel_full.xml sets a global
         default <mesh scale="0.001"/> (robot STLs are in mm) which otherwise shrinks these
         meter-unit OBJs 1000x into invisible point hulls -->
    <mesh name="mug_red_mesh" file="../assets/objects/ACE_Coffee_Mug_Kristen_16_oz_cup/model.obj" scale="1 1 1"/>
    <texture type="2d" name="mug_blue_tex" file="../assets/objects/Cole_Hardware_Mug_Classic_Blue/texture.png"/>
    <material name="mug_blue_mat" texture="mug_blue_tex" specular="0.3" shininess="0.4"/>
    <mesh name="mug_blue_mesh" file="../assets/objects/Cole_Hardware_Mug_Classic_Blue/model.obj" scale="1 1 1"/>
    <texture type="2d" name="bowl_tex" file="../assets/objects/Room_Essentials_Bowl_Turquiose/texture.png"/>
    <material name="bowl_mat" texture="bowl_tex" specular="0.3" shininess="0.4"/>
    <mesh name="bowl_mesh" file="../assets/objects/Room_Essentials_Bowl_Turquiose/model.obj" scale="1 1 1"/>
    <texture type="2d" name="cereal_tex" file="../assets/objects/Vans_Cereal_Honey_Nut_Crunch_11_oz_box/texture.png"/>
    <material name="cereal_mat" texture="cereal_tex" specular="0.3" shininess="0.4"/>
    <mesh name="cereal_mesh" file="../assets/objects/Vans_Cereal_Honey_Nut_Crunch_11_oz_box/model.obj" scale="1 1 1"/>
    <texture type="2d" name="teapot_tex" file="../assets/objects/Threshold_Porcelain_Teapot_White/texture.png"/>
    <material name="teapot_mat" texture="teapot_tex" specular="0.3" shininess="0.4"/>
    <mesh name="teapot_mesh" file="../assets/objects/Threshold_Porcelain_Teapot_White/model.obj" scale="1 1 1"/>
    <material name="mat_tabletop" rgba="0.55 0.40 0.28 1" reflectance="0.05" shininess="0.2"/>
    <material name="mat_tableleg" rgba="0.30 0.22 0.16 1"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="3 2 6" dir="-0.35 -0.25 -1"
           diffuse="0.72 0.70 0.64" specular="0.3 0.3 0.3" castshadow="true"/>
    <light name="sky" directional="true" pos="-3 0 6" dir="0.3 0 -1"
           diffuse="0.28 0.31 0.38" castshadow="false"/>
    <geom name="floor" type="plane" size="60 60 0.1" material="mat_grid"
          contype="1" conaffinity="1" friction="1.5 0.05 0.001"/>

    <!-- ===== manipulation table, dead ahead. The robot FACES -X (zed camera axis is
         world -X at qpos0, palms rest at x~-0.57) so the table sits at NEGATIVE x;
         mabel_manip_table.xml put it at +x, which is BEHIND today's robot. Top at
         z=0.72 keeps that scene's height convention. The home-pose fingertips dangle
         out to x=-0.71 at exactly slab height, so the front edge sits at -0.78 —
         the scene spawns contact-free and you DRIVE the base in to reach (that's
         the whole-body part). Objects cluster near the front edge. ===== -->
    <geom name="table_top" type="box" pos="-1.03 0 0.70" size="0.25 0.45 0.02"
          material="mat_tabletop" condim="3" friction="1.2 0.05 0.001"/>
    <geom name="table_leg_fl" type="box" pos="-0.81 0.40 0.34" size="0.025 0.025 0.34" material="mat_tableleg"/>
    <geom name="table_leg_fr" type="box" pos="-0.81 -0.40 0.34" size="0.025 0.025 0.34" material="mat_tableleg"/>
    <geom name="table_leg_bl" type="box" pos="-1.25 0.40 0.34" size="0.025 0.025 0.34" material="mat_tableleg"/>
    <geom name="table_leg_br" type="box" pos="-1.25 -0.40 0.34" size="0.025 0.025 0.34" material="mat_tableleg"/>

    <!-- ===== graspable primitives (clean pinch/roll test targets) ===== -->
    <body name="cube" pos="-0.84 0.0 0.75">
      <freejoint name="cube_joint"/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.85 0.25 0.20 1" mass="0.12"
            condim="6" friction="2.0 0.02 0.002" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>
    <body name="can" pos="-0.86 0.34 0.78">
      <freejoint name="can_joint"/>
      <!-- rolling friction 0.01 (vs 0.002 elsewhere): halves the standing-cylinder
           contact micro-shimmer (~4 -> ~2 mm/s, sub-0.1 mm amplitude, zero drift)
           and keeps a grasped can from rolling out of the fingers -->
      <geom type="cylinder" size="0.030 0.058" rgba="0.20 0.60 0.30 1" mass="0.15"
            condim="6" friction="2.0 0.02 0.01" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>
    <body name="ball" pos="-0.86 -0.34 0.76">
      <freejoint name="ball_joint"/>
      <geom type="sphere" size="0.030" rgba="0.95 0.75 0.15 1" mass="0.10"
            condim="6" friction="2.0 0.02 0.005" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>

    <!-- ===== realistic objects (visual mesh + invisible convex collision mesh;
         the collision geom carries the mass and the grasp recipe) ===== -->
    <body name="mug_red" pos="-0.95 0.20 0.725">
      <freejoint name="mug_red_joint"/>
      <geom type="mesh" mesh="mug_red_mesh" material="mug_red_mat" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom type="mesh" mesh="mug_red_mesh" group="3" rgba="0.6 0.6 0.6 0" mass="0.20"
            condim="6" friction="2.0 0.02 0.002" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>
    <body name="mug_blue" pos="-0.95 -0.20 0.725" euler="0 0 0.6">
      <freejoint name="mug_blue_joint"/>
      <geom type="mesh" mesh="mug_blue_mesh" material="mug_blue_mat" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom type="mesh" mesh="mug_blue_mesh" group="3" rgba="0.6 0.6 0.6 0" mass="0.20"
            condim="6" friction="2.0 0.02 0.002" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>
    <body name="bowl" pos="-1.05 0.0 0.725">
      <freejoint name="bowl_joint"/>
      <geom type="mesh" mesh="bowl_mesh" material="bowl_mat" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom type="mesh" mesh="bowl_mesh" group="3" rgba="0.6 0.6 0.6 0" mass="0.18"
            condim="6" friction="2.0 0.02 0.002" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>
    <body name="cereal" pos="-1.15 -0.30 0.725" euler="0 0 0.3">
      <freejoint name="cereal_joint"/>
      <geom type="mesh" mesh="cereal_mesh" material="cereal_mat" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom type="mesh" mesh="cereal_mesh" group="3" rgba="0.6 0.6 0.6 0" mass="0.25"
            condim="6" friction="2.0 0.02 0.002" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>
    <body name="teapot" pos="-1.15 0.28 0.725">
      <freejoint name="teapot_joint"/>
      <geom type="mesh" mesh="teapot_mesh" material="teapot_mat" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom type="mesh" mesh="teapot_mesh" group="3" rgba="0.6 0.6 0.6 0" mass="0.25"
            condim="6" friction="2.0 0.02 0.002" priority="1"
            solref="0.005 1" solimp="0.99 0.999 0.001"/>
    </body>

    <!-- ===== teleop mocap targets (palm-goal + gaze markers; the controller's
         _set_mocap is a no-op without them, WITH them you SEE the IK targets) ===== -->
    <body name="target_l" mocap="true" pos="-0.45 0.3 1.0">
      <geom group="3" type="sphere" size="0.01" contype="0" conaffinity="0" rgba="1 0 0 0.3"/>
    </body>
    <body name="target_r" mocap="true" pos="-0.45 -0.3 1.0">
      <geom group="3" type="sphere" size="0.01" contype="0" conaffinity="0" rgba="0 1 0 0.3"/>
    </body>
    <body name="gaze_point" mocap="true" pos="-1.0 0 1.0">
      <geom group="3" type="sphere" size="0.01" contype="0" conaffinity="0" rgba="0 0 1 0.3"/>
    </body>
  </worldbody>
</mujoco>
