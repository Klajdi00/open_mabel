<mujoco model="mabel_outdoor_environment">
  <!-- MABEL outdoors: open grass field under a blue sky, gravel path, primitive
       trees (bark trunks + foliage canopies), rocks, park bench, planted flower
       spots. Textures from scripts/tools/gen_env_textures.py.
       Run from repo root:  python scripts/visualize_sensors.py --scene scenes/mabel_outdoor.xml -->

  <compiler angle="radian" eulerseq="XYZ"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"
          cone="elliptic" noslip_iterations="3"/>

  <include file="../models/mabel_full.xml"/>

  <visual>
    <headlight ambient="0.50 0.52 0.55" diffuse="0.30 0.30 0.30" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
    <rgba fog="0.75 0.84 0.95 1"/>
    <map fogstart="10" fogend="30"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.45 0.68 0.93" rgb2="0.85 0.92 1.0" width="512" height="512"/>
    <texture type="2d" name="t_grass"   file="../assets/textures/grass.png"/>
    <texture type="2d" name="t_gravel"  file="../assets/textures/gravel.png"/>
    <texture type="2d" name="t_bark"    file="../assets/textures/bark.png"/>
    <texture type="2d" name="t_foliage" file="../assets/textures/foliage.png"/>
    <texture type="2d" name="t_wood"    file="../assets/textures/wood_furniture.png"/>
    <texture type="2d" name="t_rock"    file="../assets/textures/concrete.png"/>

    <material name="m_grass"   texture="t_grass"   texuniform="true" texrepeat="1.5 1.5" reflectance="0.0" shininess="0.0"/>
    <material name="m_gravel"  texture="t_gravel"  texuniform="true" texrepeat="3 3" reflectance="0.0" shininess="0.05"/>
    <material name="m_bark"    texture="t_bark"    texuniform="true" texrepeat="2 2" reflectance="0.0" shininess="0.05"/>
    <material name="m_foliage" texture="t_foliage" texuniform="true" texrepeat="3 3" reflectance="0.0" shininess="0.0"/>
    <material name="m_wood"    texture="t_wood"    texuniform="true" texrepeat="2 2" reflectance="0.05" shininess="0.2"/>
    <material name="m_rock"    texture="t_rock"    texuniform="true" texrepeat="2 2" reflectance="0.05" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- ===== sunlight ===== -->
    <light name="sun"  directional="true" pos="3 2 6" dir="-0.35 -0.25 -1" diffuse="0.72 0.70 0.64" specular="0.3 0.3 0.3" castshadow="true"/>
    <light name="sky"  directional="true" pos="-3 0 6" dir="0.3 0.0 -1" diffuse="0.28 0.31 0.38" castshadow="false"/>

    <!-- ===== ground ===== -->
    <geom name="floor" type="plane" size="12 12 0.1" material="m_grass"
          contype="1" conaffinity="1" friction="1.5 0.05 0.001"/>

    <!-- ===== gravel path curving past the robot (offset from the spawn circle) ===== -->
    <geom name="path_1" type="box" pos="-3.5 -2.2 0.006" size="2.6 0.55 0.006" material="m_gravel"/>
    <geom name="path_2" type="box" pos="-0.2 -2.6 0.006" size="1.4 0.55 0.006" euler="0 0 -0.18" material="m_gravel"/>
    <geom name="path_3" type="box" pos=" 3.0 -3.0 0.006" size="2.2 0.55 0.006" euler="0 0 -0.10" material="m_gravel"/>

    <!-- ===== trees (trunk + canopy) ===== -->
    <geom name="tree1_trunk" type="cylinder" pos="-3.5  2.5 0.75" size="0.13 0.75" material="m_bark"/>
    <geom name="tree1_can1"  type="sphere"   pos="-3.5  2.5 2.15" size="0.95" material="m_foliage"/>
    <geom name="tree1_can2"  type="sphere"   pos="-3.0  2.9 1.75" size="0.60" material="m_foliage"/>
    <geom name="tree1_can3"  type="sphere"   pos="-3.9  2.1 1.80" size="0.55" material="m_foliage"/>

    <geom name="tree2_trunk" type="cylinder" pos=" 3.6  2.2 0.70" size="0.11 0.70" material="m_bark"/>
    <geom name="tree2_can1"  type="sphere"   pos=" 3.6  2.2 1.95" size="0.80" material="m_foliage"/>
    <geom name="tree2_can2"  type="sphere"   pos=" 3.2  2.6 1.60" size="0.50" material="m_foliage"/>

    <geom name="tree3_trunk" type="cylinder" pos=" 5.5 -1.0 0.85" size="0.15 0.85" material="m_bark"/>
    <geom name="tree3_can1"  type="sphere"   pos=" 5.5 -1.0 2.40" size="1.05" material="m_foliage"/>
    <geom name="tree3_can2"  type="sphere"   pos=" 5.0 -0.5 1.95" size="0.62" material="m_foliage"/>

    <geom name="tree4_trunk" type="cylinder" pos="-5.8 -0.6 0.65" size="0.10 0.65" material="m_bark"/>
    <geom name="tree4_can1"  type="sphere"   pos="-5.8 -0.6 1.80" size="0.75" material="m_foliage"/>

    <geom name="tree5_trunk" type="cylinder" pos=" 0.8  4.6 0.80" size="0.12 0.80" material="m_bark"/>
    <geom name="tree5_can1"  type="sphere"   pos=" 0.8  4.6 2.20" size="0.90" material="m_foliage"/>
    <geom name="tree5_can2"  type="sphere"   pos=" 1.3  4.2 1.80" size="0.55" material="m_foliage"/>

    <!-- ===== rocks (half-buried) ===== -->
    <geom name="rock1" type="sphere" pos="-1.9  1.6 0.10" size="0.28" material="m_rock"/>
    <geom name="rock2" type="sphere" pos="-2.2  1.9 0.06" size="0.18" material="m_rock"/>
    <geom name="rock3" type="box"    pos=" 2.3 -1.6 0.12" size="0.30 0.22 0.18" euler="0.1 0.05 0.4" material="m_rock"/>
    <geom name="rock4" type="sphere" pos=" 4.4  0.8 0.09" size="0.24" material="m_rock"/>
    <geom name="rock5" type="box"    pos="-4.6 -3.4 0.10" size="0.24 0.18 0.14" euler="0 0.08 0.9" material="m_rock"/>

    <!-- ===== park bench beside the path ===== -->
    <geom name="bench_seat"  type="box" pos="-2.8 -1.35 0.44" size="0.75 0.18 0.03" material="m_wood"/>
    <geom name="bench_back"  type="box" pos="-2.8 -1.16 0.78" size="0.75 0.03 0.22" material="m_wood" euler="0.15 0 0"/>
    <geom name="bench_leg_l" type="box" pos="-3.45 -1.30 0.21" size="0.04 0.16 0.21" rgba="0.20 0.22 0.24 1"/>
    <geom name="bench_leg_r" type="box" pos="-2.15 -1.30 0.21" size="0.04 0.16 0.21" rgba="0.20 0.22 0.24 1"/>

    <!-- ===== flower spots (color accents) ===== -->
    <geom name="flowers1" type="cylinder" pos=" 1.8  2.6 0.015" size="0.40 0.015" rgba="0.75 0.45 0.60 1"/>
    <geom name="flowers2" type="cylinder" pos="-1.6 -3.6 0.015" size="0.34 0.015" rgba="0.85 0.72 0.35 1"/>
    <geom name="flowers3" type="cylinder" pos=" 4.9  3.2 0.015" size="0.45 0.015" rgba="0.70 0.50 0.75 1"/>

    <!-- ===== distant hedge ring hint (keeps the horizon interesting) ===== -->
    <geom name="hedge_n" type="box" pos=" 9.5  0   0.55" size="0.4 9.5 0.55" material="m_foliage"/>
    <geom name="hedge_s" type="box" pos="-9.5  0   0.55" size="0.4 9.5 0.55" material="m_foliage"/>
    <geom name="hedge_e" type="box" pos=" 0    9.5 0.55" size="9.5 0.4 0.55" material="m_foliage"/>
    <geom name="hedge_w" type="box" pos=" 0   -9.5 0.55" size="9.5 0.4 0.55" material="m_foliage"/>

    <!-- ===== teleop mocap targets (kept compatible with the teleop / WBC scripts) ===== -->
    <body name="target_l" mocap="true" pos="0.45 0.3 1.0">
      <geom group="3" type="sphere" size="0.03" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
    <body name="target_r" mocap="true" pos="0.45 -0.3 1.0">
      <geom group="3" type="sphere" size="0.03" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
    <body name="gaze_point" mocap="true" pos="0.85 0 1.0">
      <geom group="3" type="sphere" size="0.04" rgba="1 0.5 0 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

</mujoco>
