<mujoco model="mabel_simulation_environment">

  <compiler angle="radian" eulerseq="XYZ"/>
  
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"
          cone="elliptic" noslip_iterations="3"/>

  <include file="../models/mabel_full.xml"/>

  <worldbody>
    <!-- lab environment: lights + checker ground (moved here out of the robot model) -->
    <light name="sun" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <light name="fill_f" pos=" 2 0 2" dir="-1  0 -0.5" diffuse="0.3 0.3 0.4" castshadow="false"/>
    <light name="fill_b" pos="-2 0 2" dir=" 1  0 -0.5" diffuse="0.3 0.3 0.4" castshadow="false"/>
    <light name="fill_l" pos=" 0 2 2" dir=" 0 -1 -0.5" diffuse="0.3 0.3 0.4" castshadow="false"/>
    <light name="fill_r" pos=" 0 -2 2" dir=" 0  1 -0.5" diffuse="0.3 0.3 0.4" castshadow="false"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="mat_grid" contype="1" conaffinity="1" friction="1.5 0.05 0.001"/>

    <body name="target_l" mocap="true" pos="0 0.5 1">
      <geom group="3" type="sphere" size="0.04" rgba="0 1 0 0.6" contype="0" conaffinity="0"/>
    </body>
    <body name="target_r" mocap="true" pos="0 -0.5 1">
      <geom group="3" type="sphere" size="0.04" rgba="0 1 0 0.6" contype="0" conaffinity="0"/>
    </body>

    <body name="gaze_point" mocap="true" pos="-1 0 1.2">
      <geom group="3" type="sphere" size="0.05" rgba="1 0.5 0 0.5" contype="0" conaffinity="0"/>
    </body>

    <!-- WORKSTATION: right in FRONT of the robot (robot front = -x). The table top is
         deliberately LOW (surface z=0.55) so it clears the robot's resting arms, whose
         hands occupy z in [0.68, 0.92] over x in [-0.71, -0.34]; a normal-height table
         there would intersect the arms at spawn. Objects are kept short (tops <= 0.64)
         for the same reason. -->
    <body name="workstation" pos="-0.55 0 0">
      <geom name="ws_top" type="box" pos="0 0 0.53" size="0.30 0.45 0.02"
            rgba="0.95 0.95 0.97 1" friction="1 0.05 0.001"/>
      <geom name="ws_base" type="box" pos="0 0 0.255" size="0.15 0.32 0.255"
            rgba="0.15 0.15 0.17 1"/>
    </body>

    <!-- Graspable objects, each resting ON the table top (z=0.55) with a ~3 mm clearance
         so nothing penetrates the table at spawn; spread out so none overlap, and all
         within the robot's forward reach. -->
    <body name="obj_cube" pos="-0.55 0.20 0.583">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.03 0.03 0.03" mass="0.10"
            rgba="0.10 0.40 0.85 1" friction="1 0.1 0.01"/>
    </body>

    <body name="obj_can" pos="-0.55 -0.20 0.598">
      <freejoint name="can_joint"/>
      <geom name="can_geom" type="cylinder" size="0.028 0.045" mass="0.13"
            rgba="0.80 0.20 0.20 1" friction="1 0.1 0.01"/>
    </body>

    <body name="obj_ball" pos="-0.62 0.00 0.585">
      <freejoint name="ball_joint"/>
      <geom name="ball_geom" type="sphere" size="0.032" mass="0.07"
            rgba="0.95 0.65 0.10 1" friction="1 0.1 0.01"/>
    </body>

    <body name="obj_box_sm" pos="-0.47 0.30 0.588">
      <freejoint name="box_sm_joint"/>
      <geom name="box_sm_geom" type="box" size="0.025 0.025 0.035" mass="0.06"
            rgba="0.20 0.70 0.30 1" friction="1 0.1 0.01"/>
    </body>

    <body name="obj_tile" pos="-0.47 -0.30 0.567">
      <freejoint name="tile_joint"/>
      <geom name="tile_geom" type="box" size="0.045 0.045 0.015" mass="0.10"
            rgba="0.95 0.85 0.15 1" friction="1 0.1 0.01"/>
    </body>

    <body name="obj_bottle" pos="-0.70 0.22 0.598">
      <freejoint name="bottle_joint"/>
      <geom name="bottle_geom" type="cylinder" size="0.022 0.045" mass="0.08"
            rgba="0.20 0.65 0.75 1" friction="1 0.1 0.01"/>
    </body>

    <body name="obj_marble" pos="-0.70 -0.22 0.575">
      <freejoint name="marble_joint"/>
      <geom name="marble_geom" type="sphere" size="0.022" mass="0.04"
            rgba="0.55 0.25 0.75 1" friction="1 0.1 0.01"/>
    </body>
  </worldbody>

</mujoco>